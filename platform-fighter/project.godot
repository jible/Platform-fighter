; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="platform fighter"
run/main_scene="uid://by514r3mafxn4"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://assets/images/icon.svg"

[autoload]

DpShapeRenderer3d="*res://addons/deterministic_physics/physics_objects/dp_shape_renderer_3d.cs"
DpPhysicsServer="*res://addons/deterministic_physics/physics_objects/dp_physics_server.cs"
PlayerManager="*res://components/Globals/PlayerManager.cs"
NetworkManager="*res://components/Globals/NetworkManager.cs"

[display]

window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="platform fighter"

[editor_plugins]

enabled=PackedStringArray("res://addons/deterministic_physics/plugin.cfg")

[global_group]

hitboxes=""

[gui]

theme/default_font_multichannel_signed_distance_field=true

